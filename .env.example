# Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# Application (client) ID
DISCORD_CLIENT_ID=your_client_id_here

# Optional: set to your server's ID for instant guild-scoped command registration
# Leave blank to register commands globally (takes up to 1 hour to propagate)
DISCORD_GUILD_ID=

# Spotify API credentials (optional – required for Spotify URL support)
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
